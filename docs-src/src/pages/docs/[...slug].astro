---
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const docs = await getCollection("docs");

  return docs.map(doc => ({
    params: {
      slug: doc.id.replace(".md", "")
    },
    props: {
      doc
    }
  }));
}

const { doc } = Astro.props;
const { Content } = await doc.render();
---

<html>
  <body>
    <Content />
  </body>
</html>